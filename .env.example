# Copy to backend/.env for local development. Real values come from Vault at deploy time
# (kv/services/water-fast) — never commit a filled-in copy.

# Postgres. In production this is the `waterfast` database on postgres-rds-231.
DATABASE_URL=postgres://postgres:test@localhost:55432/waterfast_test

PORT=8080

# Directory holding the built frontend. Leave empty to run the API alone.
PUBLIC_DIR=../frontend/dist

# Cloudflare Access — the app verifies the JWT the edge stamps on every request.
# TEAM_DOMAIN is the Zero Trust team domain (no protocol); AUD is the Access
# application's Audience tag, visible in the Cloudflare dashboard once the
# fast.pdlab.dev Access application exists.
CF_ACCESS_TEAM_DOMAIN=petedillo-labs.cloudflareaccess.com
CF_ACCESS_AUD=

# LOCAL DEVELOPMENT ONLY. When set, every request is treated as coming from this email
# instead of verifying a JWT — there is no edge in front of a local `bun run dev`.
# The server refuses to start if this is set with NODE_ENV=production.
WATERFAST_DEV_IDENTITY=you@example.com
